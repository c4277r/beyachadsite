PORT=4000
NODE_ENV="development"
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority"

# Used to sign admin login JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"

# Frontend origin(s) allowed to call this API (CORS). Comma-separated for
# multiple origins. Leave empty to fall back to CLIENT_URL.
CLIENT_URL="http://localhost:5173"
ALLOWED_ORIGINS=""

# Resend email notifications. Verify this sender/domain in Resend before use.
RESEND_API_KEY="re_..."
EMAIL_FROM="בית ביחד <notifications@your-verified-domain.example>"
SITE_TEAM_EMAIL="beitbeyachad@gmail.com"

# Used only by `npm run admin:create`; never expose these through the client.
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-8-characters"
