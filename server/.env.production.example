NODE_ENV=production
PORT=4000
DATABASE_URL="mongodb+srv://<production-user>:<password>@<production-cluster>/<database>?retryWrites=true&w=majority"

# Generate outside the repository with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="<paste-a-random-secret-of-at-least-64-characters>"

# Replace with the exact HTTPS origin(s) used by the official public website.
ALLOWED_ORIGINS="https://<official-domain>"
CLIENT_URL="https://<official-domain>"
