PORT=4000
NODE_ENV="development"
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority"

# Used to sign admin login JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"

# Frontend origin(s) allowed to call this API (CORS). Comma-separated for
# multiple origins, e.g. "https://baitbeyached.org.il,https://www.baitbeyached.org.il"
CLIENT_URL="http://localhost:5173"
ALLOWED_ORIGINS=""
